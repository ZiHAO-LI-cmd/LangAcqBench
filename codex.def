Bootstrap: localimage
From: ./containers/vllm-0-19-1-base.sif

%files
    ./build-codex/package /opt/codex/package
    ./build-codex/package.sha256 /opt/codex/package.sha256
    ./build-codex/version.txt /opt/codex/version.txt

%post
    set -eu
    mkdir -p /opt/codex /home/agent /workspace /hf-cache
    # PID-managed daemon startup invokes ps, absent from the minimal Rocky base.
    if ! command -v ps >/dev/null 2>&1; then
        dnf install -y procps-ng
        dnf clean all
    fi
    command -v ps
    ps -p $$ -o pid=
    rpm -q procps-ng > /opt/codex/system-requirements.txt
    # Symlink into the intact package: the daemon resolves its own package root.
    ln -sf /opt/codex/package/bin/codex /usr/local/bin/codex
    ln -sf /opt/codex/package/bin/codex-code-mode-host /usr/local/bin/codex-code-mode-host
    python3 -m pip install --no-cache-dir 'sacrebleu==2.5.1'
    python3 -m pip freeze > /opt/codex/python-requirements.txt
    cat > /usr/local/bin/vllm-python <<'EOF'
#!/bin/sh
exec /usr/bin/python3 "$@"
EOF
    chmod 755 /usr/local/bin/vllm-python

%environment
    export PATH="/usr/local/bin:$PATH"
    export PYTHONNOUSERSITE=1

%test
    set -eu
    cd /opt/codex
    sha256sum -c package.sha256
    codex --version
    vllm-python -c 'import torch, vllm, sacrebleu, sentencepiece, pyarrow; print("vLLM:", vllm.__version__, "Torch:", torch.__version__, "CUDA:", torch.version.cuda)'

